{%- style -%}
  #shopify-section-{{ section.id }} .review-section {
    padding: 48px 0;
    background: {{ section.settings.background | default: '#ffffff' }};
    color: {{ section.settings.text_color | default: '#111111' }};
  }

  #shopify-section-{{ section.id }} .review-section__title.h1,
  #shopify-section-{{ section.id }} .title-container-app-review {
    font-family: Roboto, sans-serif !important;
    font-size: 42px !important;
    font-weight: 700 !important;
    color: #000000 !important;
    line-height: 1.2 !important;
    letter-spacing: normal !important;
    margin: 0 0 48px !important;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .section-title-app-review.h2,
  #shopify-section-{{ section.id }} .section-title-app-review {
    font-family: Roboto, sans-serif !important;
    font-size: 1.8rem !important;
    font-weight: 600 !important;
    color: #2c3e50 !important;
    line-height: 1.3 !important;
    letter-spacing: normal !important;
    margin: 0 0 25px !important;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .recommendation-app-review p {
    margin: 0 0 0 12px !important;
  }

  #shopify-section-{{ section.id }} .rating-stars-app-review .star-app-review {
    width: 28px;
    height: 28px;
  }

  #shopify-section-{{ section.id }} .haft-start-app-review {
    width: 28px;
    height: 28px;
    display: block;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .title-container-app-review {
      font-size: 30px !important;
      margin-bottom: 32px !important;
    }

    #shopify-section-{{ section.id }} .rating-stars-app-review .star-app-review,
    #shopify-section-{{ section.id }} .haft-start-app-review {
      width: 22px;
      height: 22px;
    }

    #shopify-section-{{ section.id }} .recommendation-app-review p {
      font-size: 18px !important;
    }
  }
{%- endstyle -%}

{{ 'app-review.css' | asset_url | stylesheet_tag }}
<script src="{{ 'app-review.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign recommend_percent = section.settings.recommend_percent | default: '98' | strip
  assign recommend_number = recommend_percent | replace: '%', '' | strip
  assign recommend_value = recommend_number | plus: 0
  if recommend_value < 0
    assign recommend_value = 0
  endif
  if recommend_value > 100
    assign recommend_value = 100
  endif
  assign circumference = 251.2
  assign dashoffset = 100 | minus: recommend_value | times: circumference | divided_by: 100.0
-%}

<section class="review-section" id="{{ section.settings.anchor_id | escape }}">
  <div class="container-app-review">
    <section class="reviews-section-app-review">
      <div style="display: flex; justify-content: center;">
        <h2 class="title-container-app-review">{{ section.settings.title | escape }}</h2>
      </div>

      <div class="rating-summary-app-review" id="rating-summary-app-review">
        <div class="rating-left-app-review">
          <div class="rating-stars-app-review">
            <div class="rating-number-app-review">{{ section.settings.rating_value | escape }}</div>
            <div>
              <div class="stars-app-review">
                <div class="star-app-review"></div>
                <div class="star-app-review"></div>
                <div class="star-app-review"></div>
                <div class="star-app-review"></div>
                <svg class="haft-start-app-review" viewBox="0 0 60 60" aria-hidden="true">
                  <defs>
                    <linearGradient id="half-gold-white-{{ section.id }}" x1="0" y1="0" x2="60" y2="0" gradientUnits="userSpaceOnUse">
                      <stop offset="50%" stop-color="gold"/>
                      <stop offset="50%" stop-color="white"/>
                    </linearGradient>
                  </defs>
                  <polygon
                    points="30,5 36.18,21.09 53,21.09 39.09,32.18 44.18,49 30,39.09 15.82,49 20.91,32.18 7,21.09 23.82,21.09"
                    fill="url(#half-gold-white-{{ section.id }})"
                    stroke="#fde047"
                    stroke-width="3"
                  />
                </svg>
              </div>
              <div class="review-count-app-review">{{ section.settings.review_count_text | escape }}</div>
            </div>
          </div>
        </div>

        <div class="rating-right-app-review">
          <div class="recommendation-app-review">
            <div class="recommendation-circle-app-review" aria-hidden="true">
              <svg width="100" height="100" viewBox="0 0 100 100">
                <circle
                  cx="50"
                  cy="50"
                  r="40"
                  stroke="#218649"
                  stroke-width="8"
                  fill="none"
                  opacity="0.2"
                />
                <circle
                  cx="50"
                  cy="50"
                  r="40"
                  stroke="#218649"
                  stroke-width="8"
                  fill="none"
                  stroke-linecap="round"
                  stroke-dasharray="251.2"
                  stroke-dashoffset="{{ dashoffset }}"
                  transform="rotate(-90 50 50)"
                />
                <text
                  x="50"
                  y="55"
                  text-anchor="middle"
                  dominant-baseline="middle"
                  font-size="45"
                  fill="#218649"
                  font-family="Arial, sans-serif"
                  font-weight="bold"
                >{{ recommend_number | escape }}</text>
              </svg>
            </div>
            <p>{{ section.settings.recommend_text | escape }}</p>
          </div>
        </div>
      </div>

      <div class="video-section-app-review">
        <h3 class="section-title-app-review">{{ section.settings.video_title | escape }}</h3>
        <div class="video-reviews-app-review">
          <div class="video-reviews-container-app-review" id="videoContainer"></div>
        </div>
      </div>

      <div class="image-section-app-review">
        <h3 class="section-title-app-review">{{ section.settings.image_title | escape }}</h3>
        <div class="image-reviews-app-review">
          <div class="image-reviews-container-app-review" id="imageContainer"></div>
        </div>
      </div>
    </section>

    <section class="customer-review-app-review"></section>

    <div style="display: flex; justify-content: center;">
      <button class="view-more-app-review" type="button" onclick="getMoreReview()">
        {{ section.settings.view_more_text | escape }}
      </button>
    </div>
  </div>
</section>

<div id="reviewModal" class="modal-app-review">
  <div class="modal-content-app-review">
    <span class="close-app-review">&times;</span>
    <div id="modalContent"></div>
  </div>
</div>

{% schema %}
{
  "name": "App review",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "rating-summary-app-review" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8" },
    { "type": "text", "id": "review_count_text", "label": "Review count text", "default": "400+ reviews" },
    { "type": "text", "id": "recommend_percent", "label": "Recommendation percent (number)", "default": "98", "info": "Number only, e.g. 98 — shown inside the green circle" },
    { "type": "text", "id": "recommend_text", "label": "Recommendation text", "default": "98% would recommend" },
    { "type": "text", "id": "video_title", "label": "Video section title", "default": "Reviews with videos" },
    { "type": "text", "id": "image_title", "label": "Image section title", "default": "Reviews with images" },
    { "type": "text", "id": "view_more_text", "label": "View more button text", "default": "View 8 more" },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text color" }
  ],
  "presets": [
    {
      "name": "App review"
    }
  ]
}
{% endschema %}
