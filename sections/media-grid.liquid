{{ 'section-media-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --media-grid-row-height: {{ section.settings.mobile_row_height }}px;
    --media-grid-gap: {{ section.settings.gap }}px;
    --media-grid-radius: {{ section.settings.card_radius }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --media-grid-row-height: {{ section.settings.desktop_row_height }}px;
    }
  }

  {%- for block in section.blocks -%}
    #media-grid-{{ block.id }} {
      --media-grid-bg: {{ block.settings.background.red }}, {{ block.settings.background.green }}, {{ block.settings.background.blue }};
      --media-grid-text: {{ block.settings.text_color.red }}, {{ block.settings.text_color.green }}, {{ block.settings.text_color.blue }};
      --media-grid-button-bg: {{ block.settings.button_background.red }}, {{ block.settings.button_background.green }}, {{ block.settings.button_background.blue }};
      --media-grid-button-text: {{ block.settings.button_text_color.red }}, {{ block.settings.button_text_color.green }}, {{ block.settings.button_text_color.blue }};
      --media-grid-overlay: {{ block.settings.overlay_color.red }}, {{ block.settings.overlay_color.green }}, {{ block.settings.overlay_color.blue }};
      --media-grid-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      {%- if block.settings.background_gradient != blank -%}
        background: {{ block.settings.background_gradient }};
      {%- endif -%}
    }
  {%- endfor -%}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="media-grid-section section-{{ section.id }}-padding">
  <div class="media-grid-section__inner{% if section.settings.full_width %} media-grid-section__inner--full-width{% endif %}">
    <div class="media-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link_url != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          {% if tag == 'a' %}href="{{ block.settings.link_url }}"{% endif %}
          class="media-grid__item"
          style="--media-grid-column-span: {{ block.settings.desktop_column_span }}; --media-grid-row-span: {{ block.settings.desktop_row_span }};"
          {{ block.shopify_attributes }}
        >
          <div id="media-grid-{{ block.id }}" class="media-grid__card">
            {%- case block.type -%}
              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  {%- capture sizes -%}
                    (max-width: 749px) 100vw,
                    min({{ 390 | times: block.settings.desktop_column_span }}px, {{ 25 | times: block.settings.desktop_column_span }}vw)
                  {%- endcapture -%}
                  {{
                    block.settings.image
                    | image_url: width: 2000
                    | image_tag:
                      class: 'media-grid__media',
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800,2000'
                  }}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'media-grid__media media-grid__media--placeholder' }}
                {%- endif -%}
              {%- when 'video' -%}
                {%- if block.settings.video != blank -%}
                  {{
                    block.settings.video
                    | video_tag:
                      class: 'media-grid__media',
                      autoplay: true,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: block.settings.show_video_controls
                  }}
                {%- elsif block.settings.cover_image != blank -%}
                  {{
                    block.settings.cover_image
                    | image_url: width: 2000
                    | image_tag: class: 'media-grid__media', loading: 'lazy', widths: '400,600,800,1000,1400,2000'
                  }}
                {%- else -%}
                  {{ 'collection-2' | placeholder_svg_tag: 'media-grid__media media-grid__media--placeholder' }}
                {%- endif -%}
            {%- endcase -%}

            {%- if block.settings.title != blank or block.settings.link_text != blank -%}
              <div class="media-grid__content media-grid__content--{{ block.settings.mobile_text_position }} media-grid__content--desktop-{{ block.settings.desktop_text_position }}">
                {%- if block.settings.title != blank -%}
                  <p class="media-grid__heading {{ block.settings.heading_tag }}">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.link_text != blank -%}
                  <span class="media-grid__button">{{ block.settings.link_text | escape }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</div>

