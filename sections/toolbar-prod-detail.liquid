{%- assign detail_id = section.settings.detail_id | strip -%}
{%- assign reviews_id = section.settings.reviews_id | strip -%}
{%- assign qa_id = section.settings.qa_id | strip -%}
{%- assign related_id = section.settings.related_id | strip -%}
{%- assign active_color = section.settings.active_text_color | default: '#EF6D23' -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --toolbar-active: {{ active_color }};
  }

  #shopify-section-{{ section.id }} #sticky-tabs {
    position: relative;
    z-index: 20;
    background: {{ section.settings.background | default: '#ffffff' }};
  }

  #shopify-section-{{ section.id }} #sticky-tabs.sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background-color: #fff;
    margin: 0;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  #shopify-section-{{ section.id }} .toolbar-prod-detail__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .group-button-tool {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: {{ section.settings.background | default: '#ffffff' }};
    z-index: 1000;
    overflow: auto;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .group-button-tool a {
    text-align: center;
    height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none !important;
    padding: 5px 10px;
    color: {{ section.settings.text_color | default: '#000000' }};
    white-space: nowrap;
    font-family: Roboto, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.2;
    border-bottom: 3px solid transparent;
    flex: 1 1 auto;
  }

  #shopify-section-{{ section.id }} .group-button-tool a.active,
  #shopify-section-{{ section.id }} .group-button-tool a.is-active {
    color: var(--toolbar-active);
    border-bottom-color: var(--toolbar-active);
    font-weight: 600;
  }

  @media screen and (max-width: 575px) {
    #shopify-section-{{ section.id }} .toolbar-prod-detail__inner {
      padding: 0 12px;
    }

    #shopify-section-{{ section.id }} .group-button-tool a {
      font-size: 14px;
      padding: 5px 6px;
    }
  }
{%- endstyle -%}

<div id="sticky-tabs" class="toolbar-prod-detail" data-section-id="{{ section.id }}">
  <div class="toolbar-prod-detail__inner container">
    <div class="group-button-tool" role="navigation" aria-label="{{ section.settings.title | escape }}">
      {%- if detail_id != blank -%}
        <a href="#{{ detail_id }}" class="active" data-toolbar-link>Details</a>
      {%- endif -%}
      {%- if reviews_id != blank -%}
        <a href="#{{ reviews_id }}" id="review-tool-bar" data-toolbar-link>Reviews</a>
      {%- endif -%}
      {%- if qa_id != blank -%}
        <a href="#{{ qa_id }}" data-toolbar-link>Q&amp;A</a>
      {%- endif -%}
      {%- if related_id != blank -%}
        <a href="#{{ related_id }}" data-toolbar-link>Related Products</a>
      {%- endif -%}
    </div>
  </div>
</div>
<div id="sticky-tabs-spacer" hidden style="display: none;"></div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var tabContainer = document.getElementById('sticky-tabs');
    if (!tabContainer) return;

    var spacer = document.getElementById('sticky-tabs-spacer');
    var tabs = Array.prototype.slice.call(tabContainer.querySelectorAll('[data-toolbar-link]'));
    var stickyEnabled = {{ section.settings.enable_sticky | json }};
    var stickyOffsetTop = tabContainer.getBoundingClientRect().top + window.scrollY;
    var toolbarHeight = tabContainer.offsetHeight;

    function setActive(activeTab) {
      tabs.forEach(function (tab) {
        tab.classList.toggle('active', tab === activeTab);
        tab.classList.toggle('is-active', tab === activeTab);
      });
    }

    // Default: Details active
    if (tabs.length) setActive(tabs[0]);

    function updateSticky() {
      if (!stickyEnabled) return;
      toolbarHeight = tabContainer.offsetHeight;

      if (window.scrollY >= stickyOffsetTop) {
        if (!tabContainer.classList.contains('sticky')) {
          tabContainer.classList.add('sticky');
          if (spacer) {
            spacer.style.display = 'block';
            spacer.style.height = toolbarHeight + 'px';
            spacer.hidden = false;
          }
        }
      } else {
        tabContainer.classList.remove('sticky');
        if (spacer) {
          spacer.style.display = 'none';
          spacer.hidden = true;
        }
      }
    }

    function getTarget(href) {
      if (!href || href.charAt(0) !== '#') return null;
      var id = href.slice(1);
      if (!id) return null;
      return document.getElementById(id) || document.querySelector(href);
    }

    function scrollToTarget(target) {
      if (!target) return;
      var offset = stickyEnabled ? toolbarHeight + 8 : 8;
      var top = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function (event) {
        var href = tab.getAttribute('href');
        var target = getTarget(href);
        if (!target) return;

        event.preventDefault();
        setActive(tab);
        scrollToTarget(target);
      });
    });

    // Scroll-spy: highlight tab for section in view
    var targets = tabs
      .map(function (tab) {
        return { tab: tab, el: getTarget(tab.getAttribute('href')) };
      })
      .filter(function (item) {
        return item.el;
      });

    function updateActiveFromScroll() {
      if (!targets.length) return;
      var probe = window.scrollY + toolbarHeight + 24;
      var current = targets[0];

      targets.forEach(function (item) {
        var top = item.el.getBoundingClientRect().top + window.scrollY;
        if (top <= probe) current = item;
      });

      if (current) setActive(current.tab);
    }

    window.addEventListener(
      'scroll',
      function () {
        updateSticky();
        updateActiveFromScroll();
      },
      { passive: true }
    );

    window.addEventListener('resize', function () {
      stickyOffsetTop = tabContainer.classList.contains('sticky')
        ? stickyOffsetTop
        : tabContainer.getBoundingClientRect().top + window.scrollY;
      toolbarHeight = tabContainer.offsetHeight;
      updateSticky();
    });

    updateSticky();
  });
</script>

{% schema %}
{
  "name": "ToolBar",
  "tag": "section",
  "class": "section section-toolbar-prod-detail",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Label",
      "default": "ToolBar"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky toolbar",
      "default": true
    },
    {
      "type": "text",
      "id": "detail_id",
      "label": "Detail anchor ID",
      "default": "detail"
    },
    {
      "type": "text",
      "id": "reviews_id",
      "label": "Reviews anchor ID",
      "default": "rating-summary-app-review"
    },
    {
      "type": "text",
      "id": "qa_id",
      "label": "Q&A anchor ID",
      "default": "faq"
    },
    {
      "type": "text",
      "id": "related_id",
      "label": "Related products anchor ID",
      "default": "related-products"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Active text color",
      "default": "#EF6D23"
    }
  ],
  "presets": [
    {
      "name": "ToolBar"
    }
  ]
}
{% endschema %}
