{%- style -%}
  #shopify-section-{{ section.id }} .images-scrolling-section {
    background: {{ section.settings.background_gradient | default: section.settings.background }};
    color: {{ section.settings.text_color }};
    padding: 48px 0;
  }

  #shopify-section-{{ section.id }} .images-scrolling-section__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  #shopify-section-{{ section.id }} .images-scrolling-section__list {
    display: grid;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .images-scrolling-section__item {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .images-scrolling-section__media img,
  #shopify-section-{{ section.id }} .images-scrolling-section__media svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.6rem;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .images-scrolling-section__list {
      {% if section.settings.stack_on_mobile %}
        grid-template-columns: 1fr;
      {% else %}
        grid-auto-flow: column;
        grid-auto-columns: minmax(78vw, 1fr);
        overflow-x: auto;
      {% endif %}
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .images-scrolling-section__item {
      grid-template-columns: {% if section.settings.image_position == 'start' %}minmax(0, 1.1fr) minmax(0, 0.9fr){% else %}minmax(0, 0.9fr) minmax(0, 1.1fr){% endif %};
    }
  }
{%- endstyle -%}

<section class="images-scrolling-section">
  <div class="images-scrolling-section__inner">
    <div class="images-scrolling-section__list">
      {%- for block in section.blocks -%}
        <div class="images-scrolling-section__item" {{ block.shopify_attributes }}>
          <div class="images-scrolling-section__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="images-scrolling-section__content rte">
            {%- if section.settings.show_counter -%}
              <span>{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if block.settings.custom_icon != blank -%}
              {{ block.settings.custom_icon | image_url: width: block.settings.icon_width | image_tag: loading: 'lazy' }}
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h2 class="h1">{{ block.settings.title }}</h2>
            {%- endif -%}
            {{ block.settings.content }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Images and text scrolling",
  "tag": "section",
  "class": "section",
  "max_blocks": 15,
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "checkbox", "id": "stack_on_mobile", "label": "Stack on mobile", "default": false },
    { "type": "checkbox", "id": "show_counter", "label": "Show counter", "default": true },
    {
      "type": "select",
      "id": "desktop_image_effect",
      "label": "Desktop image transition",
      "options": [{ "value": "reveal", "label": "Reveal" }, { "value": "fade", "label": "Fade" }],
      "default": "reveal"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [{ "value": "start", "label": "Left" }, { "value": "end", "label": "Right" }],
      "default": "end"
    },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "color_background", "id": "background_gradient", "label": "Background gradient" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "heading_color", "label": "Heading color" },
    { "type": "color_background", "id": "heading_gradient", "label": "Heading gradient" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [{ "value": "none", "label": "None" }], "default": "none" },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon" },
        { "type": "range", "id": "icon_width", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Icon width", "default": 48 },
        { "type": "text", "id": "title", "label": "Heading", "default": "Heading" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Share product highlights and benefits here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Images and text scrolling",
      "blocks": [{ "type": "item" }, { "type": "item", "settings": { "title": "Heading 2" } }]
    }
  ]
}
{% endschema %}
