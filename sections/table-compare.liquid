{%- style -%}
  #shopify-section-{{ section.id }} {
    background: #fff;
  }

  #shopify-section-{{ section.id }} .compare-wrapper {
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 24px 48px;
    background: #fff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .compare-heading {
    text-align: center;
    margin-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .compare-title {
    font-family: Roboto, sans-serif !important;
    font-size: 28px !important;
    font-weight: 700 !important;
    margin: 0 0 8px !important;
    color: #1a1a1a !important;
    letter-spacing: -0.02em !important;
    line-height: 1.2 !important;
  }

  #shopify-section-{{ section.id }} .compare-subtitle {
    font-family: Roboto, sans-serif !important;
    font-size: 16px !important;
    color: #767676 !important;
    margin: 0 !important;
    font-weight: 400 !important;
    line-height: 1.5 !important;
  }

  /* 3 columns: Labels | Others | Our Covers */
  #shopify-section-{{ section.id }} .compare-grid {
    display: flex;
    flex-direction: column;
  }

  #shopify-section-{{ section.id }} .compare-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1.5fr;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .compare-row--body {
    border-bottom: 1px dashed #d3d3d3;
  }

  #shopify-section-{{ section.id }} .compare-row--body:last-child {
    border-bottom: none;
  }

  #shopify-section-{{ section.id }} .col-header {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 36px;
    padding: 6px 10px;
    text-align: center;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .col-header--other {
    border-left: 1px solid #d3d3d3;
  }

  #shopify-section-{{ section.id }} .col-header--highlight {
    background: #efefef;
    border-left: 1px solid #d3d3d3;
  }

  #shopify-section-{{ section.id }} .col-header span {
    font-family: Roboto, sans-serif !important;
    font-size: 20px !important;
    font-weight: 700 !important;
    color: #767676 !important;
    line-height: 1.2 !important;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    text-align: center;
    padding: 12px 10px;
    box-sizing: border-box;
    margin: 0;
    font-family: Roboto, sans-serif !important;
    font-size: 15px !important;
    line-height: 1.3 !important;
  }

  #shopify-section-{{ section.id }} .cell.title {
    font-weight: 700 !important;
    color: #1a1a1a !important;
    text-align: center;
    align-items: center;
    border-right: 1px solid #d3d3d3;
  }

  #shopify-section-{{ section.id }} .cell.other {
    background: #fbfbfb;
    color: #5c5c5c !important;
    font-weight: 400 !important;
  }

  #shopify-section-{{ section.id }} .cell.highlight {
    background: #efefef;
    font-weight: 700 !important;
    color: #1a1a1a !important;
    border-left: 1px solid #d3d3d3;
  }

  #shopify-section-{{ section.id }} .icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .icon:empty {
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .icon svg {
    display: block;
    width: 100% !important;
    height: 100% !important;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .icon svg * {
    fill: #ef6d23 !important;
    stroke: #ef6d23 !important;
  }

  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .compare-title {
      font-size: 36px !important;
    }

    #shopify-section-{{ section.id }} .col-header span {
      font-size: 24px !important;
    }

    #shopify-section-{{ section.id }} .cell {
      padding: 16px 10px;
      gap: 6px;
      font-size: 16px !important;
    }

    #shopify-section-{{ section.id }} .icon {
      width: 28px;
      height: 28px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .compare-wrapper {
      padding: 36px 12px 48px;
    }

    #shopify-section-{{ section.id }} .compare-row {
      grid-template-columns: 0.9fr 1fr 1.15fr;
    }

    #shopify-section-{{ section.id }} .compare-title {
      font-size: 24px !important;
    }

    #shopify-section-{{ section.id }} .compare-subtitle {
      font-size: 14px !important;
    }

    #shopify-section-{{ section.id }} .col-header span {
      font-size: 13px !important;
    }

    #shopify-section-{{ section.id }} .cell {
      padding: 10px 6px;
      font-size: 11px !important;
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .icon {
      width: 20px;
      height: 20px;
    }
  }
{%- endstyle -%}

<div class="compare-wrapper" id="{{ section.settings.anchor_id | escape }}">
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="compare-heading">
      {%- if section.settings.title != blank -%}
        <h2 class="compare-title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="compare-subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="compare-grid">
    {%- comment -%} Header: (empty) | Others | Our Covers {%- endcomment -%}
    <div class="compare-row compare-row--header">
      <div class="col-header"></div>
      <div class="col-header col-header--other">
        <span>{{ section.settings.other_title | default: 'Others' | escape }}</span>
      </div>
      <div class="col-header col-header--highlight">
        <span>{{ section.settings.cover_title | default: 'Our Covers' | escape }}</span>
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div class="compare-row compare-row--body" {{ block.shopify_attributes }}>
        <div class="cell title">
          <div class="icon" aria-hidden="true"></div>
          <span>{{ block.settings.title | escape }}</span>
        </div>

        <div class="cell other">
          <div class="icon" aria-hidden="true"></div>
          <span>{{ block.settings.other | escape }}</span>
        </div>

        <div class="cell highlight">
          {%- if block.settings.svg_icon != blank -%}
            <div class="icon">{{ block.settings.svg_icon }}</div>
          {%- else -%}
            <div class="icon" aria-hidden="true"></div>
          {%- endif -%}
          <span>{{ block.settings.highlight | escape }}</span>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Compare Table",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "compare-table"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Why Choose Us"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Compare our product with others"
    },
    {
      "type": "text",
      "id": "other_title",
      "label": "Column title (Others)",
      "default": "Others"
    },
    {
      "type": "text",
      "id": "cover_title",
      "label": "Column title (Our Covers)",
      "default": "Our Covers"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label (left column)"
        },
        {
          "type": "text",
          "id": "other",
          "label": "Others value (middle)"
        },
        {
          "type": "text",
          "id": "highlight",
          "label": "Our Covers value (right)"
        },
        {
          "type": "textarea",
          "id": "svg_icon",
          "label": "SVG Icon (Our Covers)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compare Table",
      "blocks": [
        { "type": "row" },
        { "type": "row" },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
