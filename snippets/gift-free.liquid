

    <style>
        .header-bar {
            height: 4px;
            width: 100%;
            margin-bottom: 15px;
        }

        .main-title {
            text-align: center;
            font-size: 22px;
            font-weight: 500;
            color: #1a1a1a;
            margin-bottom: 15px;
            font-family: Roboto, sans-serif;
        }

        .gifts-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .gift-item {
            width: 100%;
        }

        .offer-box {
            width: 100%;
            height: auto;
            min-height: 136px;
            border-radius: 8px;
        }
        .offer-text {
            color: white;
            font-size: 14px;
            font-weight: bold;
            line-height: 1.2;
        }

        .product-box {
            width: 100%;
            height: auto;
            background-color: white;
            border: 2px dashed #FDA751;
            border-radius: 8px;
            position: relative;
            margin-bottom: 10px;
            padding: 10px;
        }

        .price-tag {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #FFD700;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: bold;
            min-width: 95px;
        }

        .price-original {
            text-decoration: line-through;
            color: #666;
        }

        .price-free {
            color: #000;
        }

        .product-image {
            width: 100%;
            height: auto;
            background-color: #f0f0f0;
            border-radius: 8px;
        }

        .steering-wheel {
            width: 100px;
            height: 100px;
            background-color: #333;
            border-radius: 50%;
            position: relative;
        }

        .steering-wheel::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 20px;
            height: 20px;
            background-color: #666;
            border-radius: 50%;
        }

        .towel {
            width: 80px;
            height: 100px;
            background: linear-gradient(45deg, #666, #888);
            border-radius: 8px;
            position: relative;
        }

        .towel::before {
            content: "S";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #FFD700;
            font-size: 24px;
            font-weight: bold;
        }

        .towel::after {
            content: "LUXE MICROFIBER TOWEL";
            position: absolute;
            bottom: -25px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 8px;
            color: white;
            background-color: black;
            padding: 2px 4px;
            border-radius: 2px;
            white-space: nowrap;
        }

        .gift-label {
            color: black;
            font-size: 14px;
            font-weight: normal;
            margin-top: 10px;
            text-align: center;
        }
        @media(max-width: 575px){
        
            .gifts-container {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }
            .main-title {
                font-size: 14px;
            }
            .offer-box {
                min-height: auto;
            }
        }
    </style>

