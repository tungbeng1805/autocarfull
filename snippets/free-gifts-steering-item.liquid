{%- comment -%}
  One steering-wheel free gift row, matched to a cart line-item color.
  Variables: color_label (string), badge_qty (number)
{%- endcomment -%}

{%- liquid
  assign free_gift_steering_compare_cents = 3900
  assign color_handle = color_label | handleize
  assign steering_title = 'Luxury Steering Wheel Covers'
  assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/Thi_tk_ch_acoten_27.png?v=1753449997'
  assign steering_title_suffix = 'Solid Black'

  case color_handle
  when 'black-red'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-black-red.webp?v=1777908617'
    assign steering_title_suffix = 'Black & Red'
  when 'black-grey'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-black-grey.webp?v=1777908617'
    assign steering_title_suffix = 'Black & Grey'
  when 'black-red-line'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-red-line.jpg?v=1778926284'
    assign steering_title_suffix = color_label
  when 'black'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-solid-black.webp?v=1777908602'
    assign steering_title_suffix = 'Solid Black'
  when 'beige'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-solid-beige.webp?v=1777908618'
    assign steering_title_suffix = 'Beige'
  when 'black-blue'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-black-blue.webp?v=1777908618'
    assign steering_title_suffix = 'Black & Blue'
  when 'wine-red'
      assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-solid-wine-red.webp?v=1777908618'
      assign steering_title_suffix = 'Wine Red'
  when 'black-white'
    assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-black-white.webp?v=1777908617'
      assign steering_title_suffix = 'Black White'
    when 'brown-coffe', 'brown-coffee'
      assign steering_image = 'https://cdn.shopify.com/s/files/1/0918/9654/5652/files/sw-coffe.jpg?v=1778926354'
      assign steering_title_suffix = 'Brown Coffee'

    else
      if color_label != blank
        assign steering_title_suffix = color_label
      endif
  endcase
-%}

<article class="free-gifts-grid__item free-gifts-grid__item--steering" data-steering-color="{{ color_handle }}">
  <div class="free-gifts-grid__media">
    <span class="free-gifts-grid__badge">{{ badge_qty }}</span>
    <img
      class="free-gifts-grid__image"
      src="{{ steering_image }}"
      alt="{{ steering_title }} | {{ steering_title_suffix }}"
      width="72"
      height="72"
      loading="lazy"
    >
  </div>
  <div class="free-gifts-grid__info">
    <h3 class="free-gifts-grid__title">{{ steering_title }} | {{ steering_title_suffix }}</h3>
    <p class="free-gifts-grid__prices">
      <span class="free-gifts-grid__price-current">$0.00</span>
      <span class="free-gifts-grid__price-compare">{{ free_gift_steering_compare_cents | money }}</span>
    </p>
  </div>
</article>
